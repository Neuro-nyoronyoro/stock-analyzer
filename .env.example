# Anthropic API キー（https://console.anthropic.com/ で取得）
ANTHROPIC_API_KEY=your_api_key_here

# J-Quants API（日本株データ・無料登録: https://jpx-jquants.com/）
JQUANTS_REFRESH_TOKEN=your_refresh_token_here

# NewsAPI（ニュース取得・無料登録: https://newsapi.org/）
NEWS_API_KEY=your_news_api_key_here

# アプリの公開URL（認証メール・パスワードリセットメールのリンク生成に使用）
# 本番(EC2): nginx経由のhttpsアドレスを指定（ポート番号は不要）
APP_URL=https://app.kimura-stock.com
